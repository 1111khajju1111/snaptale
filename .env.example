# SnapTale Environment Configuration
APP_ENV=development
PORT=8000

# Database (Aiven PostgreSQL in production, local Postgres / SQLite in dev)
DATABASE_URL=sqlite+aiosqlite:///./snaptale.db

# Supabase Auth & Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=CHANGE_ME_TO_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_TO_SUPABASE_SERVICE_ROLE_KEY
STORAGE_BUCKET=snaptale-media

# AI Provider
# production: huggingface | development: mock
AI_PROVIDER=huggingface
AI_PROVIDER_API_KEY=
HF_TOKEN=CHANGE_ME_TO_HUGGINGFACE_TOKEN
HF_PROVIDER=auto
HF_TEXT_MODEL=openai/gpt-oss-20b
HF_VISION_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# Optional legacy provider
GEMINI_API_KEY=

# Redis Caching & Queues (optional)
REDIS_URL=redis://localhost:6379/0

# Security & CORS
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,https://snaptale.vercel.app

# Daily Usage Limits (MVP Cost Control)
MAX_STORIES_PER_DAY=3
MAX_MUTATIONS_PER_DAY=5
MAX_REMIXES_PER_DAY=5
MAX_IMAGES_PER_STORY=1
